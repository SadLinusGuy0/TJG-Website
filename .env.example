# Blog: Sanity is the default source. Public dataset reads need no token.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional private dataset reader: use read-only access, never a migration token.
SANITY_READ_TOKEN=
# Only the explicitly invoked migration script uses this write credential.
SANITY_MIGRATION_TOKEN=

# Optional legacy WordPress source. Visitors cannot change fetch destinations.
WORDPRESS_SOURCE_URL=https://tjg8.wordpress.com
# Comma-separated exact HTTPS origins approved by the operator; omit trailing paths.
WORDPRESS_ALLOWED_ORIGINS=
WP_REVALIDATE_SECONDS=300
# Migration-only source (the script writes to Sanity when manually invoked).
WP_SOURCE_URL=https://tjg8.wordpress.com

# Optional integrations; use `vercel env pull` for an existing linked environment.
FLAGS=
FLAGS_SECRET=
EDGE_CONFIG=
GUMROAD_ACCESS_TOKEN=
# Authenticate revalidation via a Sanity signature or x-revalidate-token.
SANITY_WEBHOOK_SECRET=
REVALIDATE_SECRET=
# Optional edition for localhost/generated URLs: normal or college. Known domains take priority.
SITE_EDITION=normal
